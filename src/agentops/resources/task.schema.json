{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["title", "objective", "scope", "workflow", "criteria", "checks", "sprint"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "scope": {"type": "string", "minLength": 1, "maxLength": 4000},
    "workflow": {"enum": ["code", "documentation", "eda", "modeling", "other"]},
    "criteria": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "checks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,60}$"}},
    "sprint": {"type": "string", "minLength": 1, "maxLength": 100},
    "limitations": {"type": "string", "maxLength": 4000}
  }
}
